<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="legged_balance2">

    <xacro:arg name="load_chassis" default="true"/>
    <xacro:arg name="add_wheel" default="true"/>
    <xacro:arg name="load_gimbal" default="true"/>
    <xacro:arg name="load_shooter" default="true"/>
    <xacro:arg name="camera_link" default="camera_link"/>
    <xacro:arg name="camera_optical_frame" default="camera_optical_frame"/>
    <xacro:arg name="camera2_optical_frame" default="camera2_optical_frame"/>
    <xacro:arg name="use_simulation" default="true"/>

    <xacro:if value="$(arg load_chassis)">
        <xacro:include filename="$(find rm_description)/urdf/legged_balance2/chassis.urdf.xacro"/>
        <xacro:chassis add_wheel="$(arg add_wheel)" use_simulation="$(arg use_simulation)"/>

        <xacro:include filename="$(find rm_description)/urdf/common/imu.urdf.xacro"/>
        <xacro:IMU connected_to="base_link" imu_name="base_imu" xyz="0.123 -0.045 -0.072"
                   rpy="0 0 ${pi/2}"/>

        <xacro:if value="$(arg load_gimbal)">
            <xacro:include filename="$(find rm_description)/urdf/legged_balance2/gimbal.urdf.xacro"/>
            <xacro:include filename="$(find rm_description)/urdf/legged_balance2/gimbal.transmission.urdf.xacro"/>
            <xacro:include filename="$(find rm_description)/urdf/common/camera.urdf.xacro"/>
            <xacro:include filename="$(find rm_description)/urdf/common/imu.urdf.xacro"/>
            <xacro:camera_sensor xyz="-0.016086 0.0 0.107908" rpy="0 0.06981316 0" frame_id="$(arg camera_link)"
                                 parent="pitch"
                                 camera_sim="$(arg use_simulation)"
                                 camera_type="hk_camera"/>
            <xacro:camera_optical_frame xyz="0.06059775176285364 0.000087 0.09256327160978175"
                                        rpy="-1.5791064 0 -1.5607963"
                                        frame_id="$(arg camera_optical_frame)"
                                        parent="pitch"
                                        camera_sim="false"/>
            <xacro:camera_optical_frame xyz="0.06059775176285364 0.000087 0.09256327160978175"
                                        rpy="-1.6501064 0 -1.53057963"
                                        frame_id="$(arg camera2_optical_frame)"
                                        parent="pitch"
                                        camera_sim="false"/>
            <xacro:IMU connected_to="pitch" imu_name="gimbal_imu"
                       xyz="-0.04 0 0.0665"
                       rpy="${pi+0.0785} 0 ${pi/2}"/>
            <xacro:if value="$(arg load_shooter)">
                <xacro:include filename="$(find rm_description)/urdf/legged_balance2/shooter.urdf.xacro"/>
                <xacro:include filename="$(find rm_description)/urdf/legged_balance2/shooter.transmission.urdf.xacro"/>
            </xacro:if>
        </xacro:if>
    </xacro:if>

    <xacro:if value="$(arg use_simulation)">
        <gazebo>
            <plugin name="rm_ros_control" filename="librm_robot_hw_sim.so">
                <robotNamespace>/</robotNamespace>
                <robotSimType>rm_gazebo/RmRobotHWSim</robotSimType>
            </plugin>
        </gazebo>
    </xacro:if>

</robot>
