<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- https://upload.wikimedia.org/wikipedia/commons/5/52/Wheelbase_and_Track.png -->
    <xacro:property name="wheel_base" value="0.419"/>
    <xacro:property name="wheel_z_offset" value="-0.092449"/>
    <xacro:property name="wheel_joint_effort" value="9.37"/>
    <xacro:property name="wheel_joint_velocity" value="26.67"/>
    <xacro:property name="bar_x_offset" value="0.1060"/>
    <xacro:property name="bar_y_offset" value="-0.1670"/>
    <xacro:property name="bar_z_offset" value="0.02602"/>
    <xacro:property name="bar_lower_limit" value="0.003"/>
    <xacro:property name="bar_upper_limit" value="0.128"/>
    <xacro:property name="bar_joint_effort" value="20"/>
    <xacro:property name="bar_joint_velocity" value="2.18"/>

    <xacro:macro name="wheel"
                 params="connected_to prefix wheel_x_offset wheel_y_offset wheel_z_offset  mechanical_reduction">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://rm_description/meshes/balance/wheel.stl" scale="0.001 .001 0.001"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2}  0 0"/>
                <geometry>
                    <cylinder length="0.02" radius="0.125"/>.
                </geometry>
            </collision>
            <inertial>
                <mass value="0.72"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="9.115e-3" ixy="-1513.324e-9" ixz="-4566.397e-9" iyy="1.683e-2"
                         iyz="-1.382e-4" izz="9.470e-3"/>
            </inertial>
        </link>

        <joint name="${prefix}_wheel_joint" type="revolute">
            <axis xyz="0 1 0"/>
            <origin xyz="${wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
            <parent link="${connected_to}"/>
            <child link="${prefix}_wheel"/>
            <limit effort="${wheel_joint_effort}" velocity="${wheel_joint_velocity}" lower="-1e16" upper="1e16"/>
        </joint>

        <transmission name="${prefix}_wheel_joint_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <actuator name="${prefix}_wheel_joint_motor">
                <mechanicalReduction>${mechanical_reduction}</mechanicalReduction>
            </actuator>
            <joint name="${prefix}_wheel_joint">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            </joint>
        </transmission>
    </xacro:macro>

    <xacro:macro name="chassis">
        <link name="base_link">
            <inertial>
                <mass value="7.995"/>
                <origin xyz="0.010765 0.015836 -0.05442"/>
                <inertia ixx="1.654e-1" ixy="1.299e-3" ixz="6.407e-3" iyy="1.075e-1"
                         iyz="-1.123e-2" izz="2.294e-1"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://rm_description/meshes/balance/base_link.stl"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 -0.035" rpy="0 0 0"/>
                <geometry>
                    <box size="0.42 0.340 0.056"/>
                </geometry>
            </collision>
        </link>

        <xacro:wheel connected_to="base_link" prefix="left" wheel_x_offset="0" wheel_y_offset="${wheel_base/2}"
                     wheel_z_offset="${wheel_z_offset}" mechanical_reduction="36"/>
        <xacro:wheel connected_to="base_link" prefix="right" wheel_x_offset="0" wheel_y_offset="${-wheel_base/2}"
                     wheel_z_offset="${wheel_z_offset}" mechanical_reduction="-36"/>

    </xacro:macro>

</robot>
