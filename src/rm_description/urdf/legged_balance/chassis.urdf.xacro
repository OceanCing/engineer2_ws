<?xml version="1.0" encoding="utf-8"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- https://upload.wikimedia.org/wikipedia/commons/5/52/Wheelbase_and_Track.png -->
    <xacro:property name="wheel_base" value="0.490"/>
    <xacro:property name="leg_x_offset" value="0.06"/>
    <xacro:property name="leg_y_offset" value="0.192"/>
    <xacro:property name="leg_z_offset" value="0.015048"/>
    <xacro:property name="leg_pitch_offset" value="-0.872"/>
    <xacro:property name="second_leg_z_offset" value="-0.14"/>
    <xacro:property name="second_leg_pitch_offset" value="-0.1396"/>
    <xacro:property name="wheel_radius" value="0.06"/>
    <xacro:property name="wheel_z_offset" value="-0.250"/>
    <xacro:property name="wheel_joint_effort" value="3.07"/>
    <xacro:property name="wheel_joint_velocity" value="73.6"/>

    <xacro:include filename="$(find rm_description)/urdf/legged_balance/leg.urdf.xacro"/>
    <xacro:include filename="$(find rm_description)/urdf/legged_balance/leg.transmission.xacro"/>

    <xacro:macro name="wheel"
                 params="connected_to prefix wheel_x_offset wheel_y_offset wheel_z_offset  mechanical_reduction">
        <link name="${prefix}_wheel">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://rm_description/meshes/legged_balance/wheel.stl"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="${pi/2}  0 0"/>
                <geometry>
                    <cylinder length="0.02" radius="${wheel_radius}"/>.
                </geometry>
            </collision>
            <inertial>
                <mass value="0.60"/>
                <origin xyz="0 0 0"/>
                <inertia ixx="1.134e-4" ixy="0" ixz="0" iyy="2.226e-4"
                         iyz="0" izz="1.134e-4"/>
            </inertial>
        </link>

        <joint name="${prefix}_wheel_joint" type="revolute">
            <axis xyz="0 1 0"/>
            <origin xyz="${wheel_x_offset} ${wheel_y_offset} ${wheel_z_offset}" rpy="0 0 0"/>
            <parent link="${connected_to}"/>
            <child link="${prefix}_wheel"/>
            <limit effort="${wheel_joint_effort}" velocity="${wheel_joint_velocity}" lower="-1e16" upper="1e16"/>
        </joint>

        <transmission name="${prefix}_wheel_joint_trans">
            <type>transmission_interface/SimpleTransmission</type>
            <actuator name="${prefix}_wheel_joint_motor">
                <mechanicalReduction>${mechanical_reduction}</mechanicalReduction>
            </actuator>
            <joint name="${prefix}_wheel_joint">
                <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
            </joint>
        </transmission>
    </xacro:macro>


    <xacro:macro name="chassis" params="use_simulation">
        <link name="base_link">
            <inertial>
                <mass value="10.717"/>
                <origin xyz="0.0012863 0.009126 0.0"/>
                <inertia ixx="1.578e-1" ixy="-3.301e-4" ixz="-7.991e-3" iyy="1.774e-1"
                         iyz="7.624e-3" izz="2.799e-1"/>
            </inertial>
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <mesh filename="package://rm_description/meshes/legged_balance/base_link.stl"/>
                </geometry>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.498 0.34 0.18"/>
                </geometry>
            </collision>
        </link>

        <xacro:first_leg connected_to="base_link" prefix="left_front" reflex="1" pitch_offset="${-leg_pitch_offset}"
                         leg_x_offset="${leg_x_offset}"
                         leg_y_offset="${leg_y_offset}"
                         leg_z_offset="${leg_z_offset}" mechanical_reduction="-1"/>
        <xacro:first_leg connected_to="base_link" prefix="right_front" reflex="1" pitch_offset="${-leg_pitch_offset}"
                         leg_x_offset="${leg_x_offset}"
                         leg_y_offset="${-leg_y_offset}"
                         leg_z_offset="${leg_z_offset}" mechanical_reduction="1"/>
        <xacro:first_leg connected_to="base_link" prefix="left_back" reflex="-1" pitch_offset="${leg_pitch_offset}"
                         leg_x_offset="${-leg_x_offset}"
                         leg_y_offset="${leg_y_offset}"
                         leg_z_offset="${leg_z_offset}" mechanical_reduction="-1"/>
        <xacro:first_leg connected_to="base_link" prefix="right_back" reflex="-1" pitch_offset="${leg_pitch_offset}"
                         leg_x_offset="${-leg_x_offset}"
                         leg_y_offset="${-leg_y_offset}"
                         leg_z_offset="${leg_z_offset}" mechanical_reduction="1"/>

        <xacro:second_leg connected_to="left_front_first_leg" prefix="left_front"
                          pitch_offset="${second_leg_pitch_offset}" leg_x_offset="0"
                          leg_y_offset="0" leg_z_offset="${-second_leg_z_offset}"/>
        <xacro:second_leg connected_to="right_front_first_leg" prefix="right_front"
                          pitch_offset="${second_leg_pitch_offset}" leg_x_offset="0"
                          leg_y_offset="0" leg_z_offset="${-second_leg_z_offset}"/>
        <xacro:second_leg connected_to="left_back_first_leg" prefix="left_back"
                          pitch_offset="${-second_leg_pitch_offset}" leg_x_offset="0"
                          leg_y_offset="0" leg_z_offset="${-second_leg_z_offset}"/>
        <xacro:second_leg connected_to="right_back_first_leg" prefix="right_back"
                          pitch_offset="${-second_leg_pitch_offset}" leg_x_offset="0"
                          leg_y_offset="0" leg_z_offset="${-second_leg_z_offset}"/>

        <xacro:leg_transmission use_simulation="${use_simulation}" prefix="left" mechanical_reduction="-1"
                                front_offset="${pi-3.837}" back_offset="3.837" second_leg_pitch_offset="${-second_leg_pitch_offset}" l1="0.14" l2="0.25" l5="0.12"/>
        <xacro:leg_transmission use_simulation="${use_simulation}" prefix="right" mechanical_reduction="1"
                                front_offset="${pi-3.837}" back_offset="3.837" second_leg_pitch_offset="${-second_leg_pitch_offset}" l1="0.14" l2="0.25" l5="0.12"/>

        <gazebo>
            <joint name="left_connect_joint" type="revolute">
                <parent>left_front_second_leg</parent>
                <child>left_back_second_leg</child>
                <axis>
                    <xyz>0 1 0</xyz>
                </axis>
                <pose>0 0 -0.25 0 0 0</pose>
            </joint>
        </gazebo>

        <gazebo>
            <joint name="right_connect_joint" type="revolute">
                <parent>right_front_second_leg</parent>
                <child>right_back_second_leg</child>
                <axis>
                    <xyz>0 1 0</xyz>
                </axis>
                <pose>0 0 -0.25 0 0 0</pose>
            </joint>
        </gazebo>

        <xacro:wheel connected_to="left_front_second_leg" prefix="left" wheel_x_offset="0"
                     wheel_y_offset="${wheel_base/2-leg_y_offset}"
                     wheel_z_offset="${wheel_z_offset}" mechanical_reduction="-13"/>
        <xacro:wheel connected_to="right_front_second_leg" prefix="right" wheel_x_offset="0"
                     wheel_y_offset="${-(wheel_base/2-leg_y_offset)}"
                     wheel_z_offset="${wheel_z_offset}" mechanical_reduction="13"/>

    </xacro:macro>

</robot>
