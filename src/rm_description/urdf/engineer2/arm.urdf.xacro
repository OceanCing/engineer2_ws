            <inertial>
                <mass value="2.95894"/>
                <origin xyz="0.017617  -0.210045  -0.017709 "/>
                <inertia ixx="5.363e-2" ixy="-1.042e-4" ixz="1.826433e-5" iyy="1.707e-3" iyz="-1.064e-3" izz="5.273e-2"/>
            </inertial>
