        <link name="yaw"/>
        <joint name="yaw_joint" type="fixed">
            <parent link="base_link"/>
            <child link="yaw"/>
            <origin xyz="0. 0. 1." rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
        </joint>
<!--        <joint name="yaw_joint" type="revolute">-->
