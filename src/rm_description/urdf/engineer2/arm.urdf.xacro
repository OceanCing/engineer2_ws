            </visual>
            <inertial>
                <mass value="1.6955"/>
                <origin xyz="0.009284 -0.045785 -0.000098"/>
                <inertia ixx="3.218e-3" ixy="8.837e-4" ixz="1.9697012e-5" iyy="1.954e-3" iyz="-1.69635e-7" izz="4.384e-3"/>
            </inertial>
            <collision>
