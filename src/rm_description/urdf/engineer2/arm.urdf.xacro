        <joint name="joint1" type="prismatic">
            <parent link="${connected_to}"/>
            <child link="link1"/>
            <origin xyz="-0.008 0.189 0.25475" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <xacro:if value="${use_simulation}">
                <limit lower="${joint1_lower_limit}" upper="${joint1_upper_limit}"
                       velocity="${joint1_velocity}" effort="300"/>
            </xacro:if>
            <xacro:unless value="${use_simulation}">
                <limit lower="${joint1_lower_limit}" upper="${joint1_upper_limit}"
                       velocity="${joint1_velocity}" effort="${joint1_effort}"/>
            </xacro:unless>
            <dynamics damping="0.0" friction="0.1"/>
        </joint>


        <joint name="joint2" type="revolute">
            <parent link="link1"/>
            <child link="link2"/>
            <origin xyz="-0.040998 -0.390478 0.0083" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <limit lower="${joint2_lower_limit}" upper="${joint2_upper_limit}"
                   velocity="${joint2_velocity}" effort="${joint2_effort}"/>
            <dynamics damping="0.0" friction="0.1"/>
        </joint>

        <joint name="joint3" type="revolute">
            <parent link="link2"/>
            <child link="link3"/>
            <origin xyz="-0.0379 0. 0.08495" rpy="0 0 0"/>
            <axis xyz="1 0 0"/>
            <limit lower="${joint3_lower_limit}" upper="${joint3_upper_limit}"
                   velocity="${joint3_velocity}" effort="${joint3_effort}"/>
            <dynamics damping="0.0" friction="0.1"/>
        </joint>

        <joint name="joint4" type="revolute">
            <parent link="link3"/>
            <child link="link4"/>
            <origin xyz="0.004999 0. 0.185" rpy="0 0 0"/>
            <axis xyz="1 0 0"/>
            <limit lower="${joint4_lower_limit}" upper="${joint4_upper_limit}"
                   velocity="${joint4_velocity}" effort="${joint4_effort}"/>
            <dynamics damping="0.0" friction="0.1"/>
        </joint>

        <joint name="joint5" type="revolute">
            <parent link="link4"/>
            <child link="link5"/>
            <origin xyz="0.032901 -0.128 0." rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="${joint5_lower_limit}" upper="${joint5_upper_limit}"
                   velocity="${joint5_velocity}" effort="${joint5_effort}"/>
            <dynamics damping="0.0" friction="0.1"/>
        </joint>

        <joint name="joint6" type="revolute">
            <parent link="link5"/>
            <child link="link6"/>
            <origin xyz="0. -0.147 0." rpy="0 0 0"/>
            <axis xyz="1 0 0"/>
            <limit lower="${joint6_lower_limit}" upper="${joint6_upper_limit}"
                   velocity="${joint6_velocity}" effort="${joint6_effort}"/>
            <dynamics damping="0.0" friction="0.1"/>
        </joint>


        <joint name="joint7" type="revolute">
            <parent link="link6"/>
            <child link="link7"/>
            <origin xyz="0. 0.007 0." rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="${joint7_lower_limit}" upper="${joint7_upper_limit}"
                   velocity="${joint7_velocity}" effort="${joint7_effort}"/>
            <dynamics damping="0.0" friction="0.1"/>
        </joint>

        <link name="tools_link"/>
        <joint name="tools_joint" type="fixed">
            <parent link="link7"/>
            <child link="tools_link"/>
            <origin xyz="0 -0.1 0." rpy="0 0 3.141"/>
        </joint>

        <joint name="gripper_joint" type="revolute">
            <parent link="link7"/>
            <child link="gripper_link"/>
            <origin xyz="0. -0.05625 0." rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limit lower="${gripper_lower_limit}" upper="${gripper_upper_limit}"
                   velocity="${gripper_velocity}" effort="${gripper_effort}"/>
            <dynamics damping="0.0" friction="0.1"/>
        </joint>
    </xacro:macro>
