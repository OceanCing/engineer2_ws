<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find rm_description)/urdf/common/friction.urdf.xacro"/>


    <xacro:property name="front_wheel_offset_x" value="0.140"/>
    <xacro:property name="back_wheel_offset_x" value="0.075"/>
    <xacro:property name="wheel_offset_y" value="0.049"/>
    <xacro:property name="wheel_offset_z" value="0"/>


    <xacro:friction_wheel prefixs="left_front" connected_to="pitch"
                          wheel_x_offset="${front_wheel_offset_x}" wheel_y_offset="${wheel_offset_y}"
                          wheel_z_offset="${wheel_offset_z}"/>

    <xacro:friction_wheel prefixs="right_front" connected_to="pitch"
                          wheel_x_offset="${front_wheel_offset_x}" wheel_y_offset="${-wheel_offset_y}"
                          wheel_z_offset="${wheel_offset_z}"/>

    <xacro:friction_wheel prefixs="left_back" connected_to="pitch"
                          wheel_x_offset="${back_wheel_offset_x}" wheel_y_offset="${wheel_offset_y}"
                          wheel_z_offset="${wheel_offset_z}"/>

    <xacro:friction_wheel prefixs="right_back" connected_to="pitch"
                          wheel_x_offset="${back_wheel_offset_x}" wheel_y_offset="${-wheel_offset_y}"
                          wheel_z_offset="${wheel_offset_z}"/>


    <link name="trigger">
        <inertial>
            <mass value="0.169587"/>
            <origin xyz="-0.163433 -0.000184 0.010092"/>
            <inertia ixx="8.8450893E-05" ixy="-2.95478E-07" ixz="9.89765E-07" iyy="8.9848315E-05"
                     iyz="2.07837E-07" izz="1.021E-04"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rm_description/meshes/hero/trigger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <mesh filename="package://rm_description/meshes/hero/trigger.stl" scale="0.001 0.001 0.001"/>
            </geometry>
        </collision>
    </link>

    <joint name="trigger_joint" type="continuous">
        <origin xyz="-0.1625 0 -0.0145" rpy="0 0 0"/>
        <dynamics damping="0.0" friction="0.01"/>
        <limit effort="7" velocity="35" lower="-1e16" upper="1e16"/>
        <parent link="base_link"/>
        <child link="trigger"/>
        <axis xyz="0 0 1 "/>

    </joint>

</robot>
