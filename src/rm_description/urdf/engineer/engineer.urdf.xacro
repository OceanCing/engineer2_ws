<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="engineer">
    <xacro:arg name="load_chassis" default="true"/>
    <xacro:arg name="load_arm" default="true"/>
    <xacro:arg name="use_simulation" default="false"/>
    <xacro:arg name="camera_link" default="camera_link"/>
    <xacro:arg name="camera_optical_frame" default="camera_optical_frame"/>
    <xacro:arg name="roller_type" default="realistic"/>

    <xacro:if value="$(arg load_chassis)">
        <xacro:include filename="$(find rm_description)/urdf/engineer/chassis.urdf.xacro"/>
        <xacro:chassis roller_type="$(arg roller_type)"/>
    </xacro:if>

    <xacro:if value="$(arg load_arm)">
        <xacro:include filename="$(find rm_description)/urdf/engineer/arm.urdf.xacro"/>
        <xacro:arm connected_to="base_link" simulation="$(arg use_simulation)"/>

        <xacro:include filename="$(find rm_description)/urdf/engineer/arm.transmission.xacro"/>
        <xacro:arm_transmission simulation="$(arg use_simulation)"/>

        <xacro:include filename="$(find rm_description)/urdf/engineer/gimbal.urdf.xacro"/>
        <xacro:gimbal connected_to="base_link" xyz="-0.258 0. 0.084" rpy="0 0 0" simulation="$(arg use_simulation)"/>

        <xacro:include filename="$(find rm_description)/urdf/engineer/ore_bin.urdf.xacro"/>
        <xacro:ore_bin connected_to="base_link" simulation="$(arg use_simulation)"/>
<!--        <xacro:unless value="$(arg use_simulation)">-->
<!--            <xacro:include filename="$(find rm_description)/urdf/common/camera.urdf.xacro"/>-->
<!--            <xacro:camera_sensor xyz="-0.0232 0 0.3765" rpy="0. 0. 0." frame_id="$(arg camera_link)" parent="gimbal_lifter"-->
<!--                                 camera_sim="$(arg use_simulation)"/>-->
<!--            <xacro:camera_optical_frame xyz="0.0035 0. 0.3765" rpy="-1.570796 0. -1.570796"-->
<!--                                        frame_id="$(arg camera_optical_frame)" parent="gimbal_lifter"-->
<!--                                        camera_sim="$(arg use_simulation)"/>-->
<!--        </xacro:unless>-->

    </xacro:if>
    <xacro:if value="$(arg use_simulation)">
        <gazebo>
            <plugin name="rm_ros_control" filename="librm_robot_hw_sim.so">
                <robotNamespace>/</robotNamespace>
                <robotSimType>rm_gazebo/RmRobotHWSim</robotSimType>
            </plugin>
        </gazebo>
    </xacro:if>

</robot>
