<?xml version="1.0" ?>

<launch>
    <arg name="robot_type" default="$(env ROBOT_TYPE)"/>

    <param name="robot_description" command="$(find xacro)/xacro $(find rm_description)/urdf/$(arg robot_type)/$(arg robot_type).urdf.xacro
      load_gimbal:=false load_shooter:=false use_simulation:=false roller_type:=none
"/>

    <node name="rm_ecat_hw" pkg="rm_ecat_ros" type="rm_ecat_hw" output="screen" launch-prefix="ethercat_grant">
        <param name="setupFile" value="$(find rm_ecat_example)/config/setup.yaml"/>
    </node>
</launch>
